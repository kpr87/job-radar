# For local runs only. Copy to .env, fill in, then:
#   set -a; source .env; set +a
#   uv run jobradar run --dry-run --direct --force-collect
# On GitHub these go in Settings > Secrets and variables > Actions. Never commit a filled-in .env file.
ANTHROPIC_API_KEY=
JSEARCH_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: only if sources.linkedin.enabled is true
APIFY_TOKEN=
# Dice needs no key.
